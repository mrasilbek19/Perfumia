<%- include('includes/header') %>

    <link rel="stylesheet" type="text/css" href="/css/users.css" />

    <body>
        <div class="users-container">
            <% if(!member) { %>
                <div class="navigation-menu">
                    <ul class="nav justify-content-center">
                        <li class="nav-item" style="cursor: pointer">
                            <a class="nav-link active" href="/admin/">Home</a>
                        </li>
                        <li class="nav-item" style="cursor: pointer">
                            <a class="nav-link" href="/admin/signup">SignUp</a>
                        </li>
                        <li class="nav-item" style="cursor: pointer">
                            <a class="nav-link" href="/admin/login">Login</a>
                        </li>
                    </ul>
                </div>

                <div class="users-frame logged-out-message">
                    <div class="board">Please login first!</div>
                </div>

                <% } else { %>
                    <div class="navigation-menu">
                        <ul class="nav justify-content-center">
                            <li class="nav-item" style="cursor: pointer">
                                <a class="nav-link active" href="/admin/">Home</a>
                            </li>
                            <li class="nav-item" style="cursor: pointer">
                                <a class="nav-link" href="/admin/product/all">Menu</a>
                            </li>
                            <li class="nav-item" style="cursor: pointer">
                                <a class="nav-link" href="/admin/user/all">Users</a>
                            </li>
                            <li class="nav-item" style="cursor: pointer"
                                onclick="return confirm('Do you really want to logout?')">
                                <a class="nav-link" href="/admin/logout">Logout</a>
                            </li>
                        </ul>
                    </div>

                    <div class="users-frame">
                        <div class="board">
                            <div class="user-table">
                                <div class="page-heading">
                                    <span class="page-eyebrow">PERFUMIA ADMIN</span>
                                    <h1 class="header-name">Users</h1>
                                    <span class="heading-rule" aria-hidden="true"></span>
                                </div>
                                <div class="table-shell">
                                    <table class="table table-hover table-sm">
                                        <thead class="thead-light">
                                            <tr class="thead-light">
                                                <th scope="col">No</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Phone</th>
                                                <th scope="col">Status</th>
                                            </tr>
                                        </thead>

                                        <% users.map(function(value, index) { %>
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        <%= index+1 %>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="user-name" aria-haspopup="dialog"
                                                            data-user="<%= JSON.stringify({ memberNick: value.memberNick, memberEmail: value.memberEmail, memberPhone: value.memberPhone, memberAddress: value.memberAddress, memberDesc: value.memberDesc, memberImage: value.memberImage, memberType: value.memberType, memberStatus: value.memberStatus, memberPoints: value.memberPoints }) %>">
                                                            <%= value.memberNick || 'Not provided' %>
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <%= value.memberPhone %>
                                                    </td>
                                                    <td style="width: 13%">
                                                        <select class="spec-select member-status" id="<%= value._id%>">
                                                            <option value="ACTIVE" <%=value.memberStatus==='ACTIVE'
                                                                ? 'selected' : '' %>>ACTIVE</option>
                                                            <option value="BLOCK" <%=value.memberStatus==='BLOCK'
                                                                ? 'selected' : '' %>>BLOCK</option>
                                                            <option value="DELETE" <%=value.memberStatus==='DELETE'
                                                                ? 'selected' : '' %>>DELETE</option>
                                                        </select>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            <% })%>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
        </div>

        <% if (member) { %>
            <dialog class="user-detail-overlay" aria-labelledby="user-detail-title">
                <div class="user-detail-modal">
                    <header class="user-detail-header">
                        <button type="button" class="user-detail-close" aria-label="Close user information"
                            autofocus>&times;</button>
                        <span class="page-eyebrow">PERFUMIA ADMIN</span>
                        <h2 id="user-detail-title">User Information</h2>
                    </header>
                    <div class="user-detail-content">
                        <div class="user-detail-profile">
                            <img class="user-detail-image" alt="Default avatar" src="/img/default.webp" />
                        </div>
                        <dl class="user-detail-grid">
                            <% const detailFields={ memberNick: 'Name' , memberPhone: 'Phone' , memberEmail: 'Email' ,
                                memberAddress: 'Address' , memberType: 'Member Type' , memberStatus: 'Member Status' ,
                                memberPoints: 'Points' , memberDesc: 'Description' }; %>
                                <% Object.entries(detailFields).forEach(function([field, label]) { %>
                                    <div class="<%= field === 'memberDesc' ? 'user-detail-description' : '' %>">
                                        <dt>
                                            <%= label %>
                                        </dt>
                                        <dd data-field="<%= field %>">Not provided</dd>
                                    </div>
                                    <% }) %>
                        </dl>
                    </div>
                </div>
            </dialog>
            <% } %>

                <script type="text/javascript" src="/js/users.js"></script>

                <%- include('includes/footer') %>